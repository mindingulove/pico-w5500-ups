[Unit]
Description=UPS Battery Monitor — auto shutdown on low battery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PICO_URL=http://192.168.6.122/status
Environment=UPS_SHUTDOWN_API_ENABLED=1
Environment=UPS_SHUTDOWN_API_HOST=0.0.0.0
Environment=UPS_SHUTDOWN_API_PORT=80
Environment=UPS_SHUTDOWN_ALLOWED_IP=192.168.6.122
Environment=UPS_LOW_BATTERY_CONFIRM=30
EnvironmentFile=-/etc/default/ups_monitor
ExecStart=/usr/bin/python3 /usr/local/bin/ups_monitor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
