#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/local/bin/ups_monitor.py
    # LuCI/uhttpd already owns port 80. OpenWrt is not one of the firmware's
    # two relay-backed shutdown URLs, so it retains the aligned polling fallback.
    procd_set_param env \
        PICO_URL=http://192.168.6.122/status \
        UPS_MONITOR_DB=/root/ups_monitor.sqlite3 \
        UPS_SHUTDOWN_API_ENABLED=0 \
        UPS_LOW_BATTERY_CONFIRM=30
    procd_set_param respawn 30 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
